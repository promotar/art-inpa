<?php

namespace App\Http\Middleware;

use Closure;
use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\Response;

class EnsureStaffUser
{
    /**
     * Allow admin access for internal roles or users with explicit admin permissions.
     */
    public function handle(Request $request, Closure $next): Response
    {
        $user = $request->user();

        if (! $user) {
            abort(403);
        }

        $hasStaffRole = $user->hasAnyRole(['super-admin', 'admin', 'staff', 'employee']);
        $hasAdminPermission = $user->getAllPermissions()->isNotEmpty();

        if (! $hasStaffRole && ! $hasAdminPermission) {
            return redirect()
                ->route('front.account')
                ->with('status', 'هذه المنطقة متاحة فقط للحسابات التي تملك صلاحيات إدارية.');
        }

        return $next($request);
    }
}
