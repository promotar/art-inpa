{
    "name": "Blog",
    "slug": "blog",
    "version": "2.0.1",
    "description": "End-to-end SEO-ready WordPress Classic Editor style publishing plugin with TinyMCE, media library, revisions, autosave, categories, tags, scheduling, previews, and frontend article rendering.",
    "author": "Art INPA",
    "platform_version": ">=2.5.0 <3.0.0",
    "type": "feature",
    "provider": "Modules\\Blog\\BlogServiceProvider",
    "provider_file": "src/BlogServiceProvider.php",
    "settings": {
        "label": "Blog Settings",
        "route": "admin.plugins.blog.settings.edit"
    },
    "routes": {
        "admin": {
            "file": "routes/admin.php",
            "prefix": "admin/plugins/blog",
            "name": "admin.plugins.blog.",
            "middleware": [
                "web",
                "auth",
                "staff"
            ]
        },
        "web": {
            "file": "routes/web.php",
            "prefix": "blog",
            "name": "blog.",
            "middleware": [
                "web"
            ]
        }
    },
    "registry": {
        "routes": {
            "admin.plugins.blog.index": {
                "uri": "admin/plugins/blog",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\BlogAdminController@index",
                "description": "Blog admin landing route."
            },
            "admin.plugins.blog.settings.edit": {
                "uri": "admin/plugins/blog/settings",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\BlogAdminController@settings",
                "description": "Blog plugin settings landing route."
            },
            "admin.plugins.blog.posts.index": {
                "uri": "admin/plugins/blog/posts",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@index",
                "description": "List Blog posts."
            },
            "admin.plugins.blog.posts.create": {
                "uri": "admin/plugins/blog/posts/create",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@create",
                "description": "Create a new Blog post."
            },
            "admin.plugins.blog.posts.store": {
                "uri": "admin/plugins/blog/posts",
                "methods": [
                    "POST"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@store",
                "description": "Store a Blog post."
            },
            "admin.plugins.blog.posts.edit": {
                "uri": "admin/plugins/blog/posts/*/edit",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@edit",
                "description": "Edit a Blog post."
            },
            "admin.plugins.blog.posts.update": {
                "uri": "admin/plugins/blog/posts/*",
                "methods": [
                    "PUT",
                    "PATCH"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@update",
                "description": "Update a Blog post."
            },
            "admin.plugins.blog.posts.destroy": {
                "uri": "admin/plugins/blog/posts/*",
                "methods": [
                    "DELETE"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@destroy",
                "description": "Soft-delete a Blog post."
            },
            "admin.plugins.blog.posts.preview": {
                "uri": "admin/plugins/blog/posts/*/preview",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@preview",
                "description": "Preview a draft, private, scheduled, or published Blog post."
            },
            "admin.plugins.blog.posts.autosave": {
                "uri": "admin/plugins/blog/posts/autosave",
                "methods": [
                    "POST"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@autosave",
                "description": "Autosave a Blog post revision."
            },
            "admin.plugins.blog.posts.slug": {
                "uri": "admin/plugins/blog/posts/slug",
                "methods": [
                    "POST"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@slug",
                "description": "Generate a unique Blog post slug."
            },
            "admin.plugins.blog.posts.revisions.restore": {
                "uri": "admin/plugins/blog/posts/*/revisions/*/restore",
                "methods": [
                    "POST"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@restoreRevision",
                "description": "Restore a Blog post revision."
            },
            "admin.plugins.blog.posts.revisions.destroy": {
                "uri": "admin/plugins/blog/posts/*/revisions/*",
                "methods": [
                    "DELETE"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@destroyRevision",
                "description": "Delete a Blog post revision."
            },
            "admin.plugins.blog.media.index": {
                "uri": "admin/plugins/blog/media",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@mediaLibrary",
                "description": "List Blog media items for the editor modal."
            },
            "admin.plugins.blog.media.store": {
                "uri": "admin/plugins/blog/media",
                "methods": [
                    "POST"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@uploadMedia",
                "description": "Upload Blog media."
            },
            "admin.plugins.blog.media.update": {
                "uri": "admin/plugins/blog/media/*",
                "methods": [
                    "PATCH"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@updateMedia",
                "description": "Update Blog media metadata."
            },
            "admin.plugins.blog.media.destroy": {
                "uri": "admin/plugins/blog/media/*",
                "methods": [
                    "DELETE"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@destroyMedia",
                "description": "Delete Blog media."
            },
            "admin.plugins.blog.categories.index": {
                "uri": "admin/plugins/blog/categories",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\CategoryController@index",
                "description": "List Blog categories."
            },
            "admin.plugins.blog.categories.create": {
                "uri": "admin/plugins/blog/categories/create",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\CategoryController@create",
                "description": "Create a new Blog category."
            },
            "admin.plugins.blog.categories.store": {
                "uri": "admin/plugins/blog/categories",
                "methods": [
                    "POST"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\CategoryController@store",
                "description": "Store a Blog category."
            },
            "admin.plugins.blog.categories.quick-store": {
                "uri": "admin/plugins/blog/categories/quick",
                "methods": [
                    "POST"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\CategoryController@quickStore",
                "description": "Create a Blog category from the post editor."
            },
            "admin.plugins.blog.categories.edit": {
                "uri": "admin/plugins/blog/categories/*/edit",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\CategoryController@edit",
                "description": "Edit a Blog category."
            },
            "admin.plugins.blog.categories.update": {
                "uri": "admin/plugins/blog/categories/*",
                "methods": [
                    "PUT",
                    "PATCH"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\CategoryController@update",
                "description": "Update a Blog category."
            },
            "admin.plugins.blog.categories.destroy": {
                "uri": "admin/plugins/blog/categories/*",
                "methods": [
                    "DELETE"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\CategoryController@destroy",
                "description": "Delete a Blog category."
            },
            "blog.index": {
                "uri": "blog",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\BlogController@index",
                "description": "Public Blog index."
            },
            "blog.categories": {
                "uri": "blog/category",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\BlogController@categories",
                "description": "Public Blog category listing."
            },
            "blog.styles": {
                "uri": "blog/assets/blog.css",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\BlogController@styles",
                "description": "Serve the Blog frontend stylesheet directly from the plugin."
            },
            "blog.category": {
                "uri": "blog/category/*",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\BlogController@category",
                "description": "Public Blog category archive."
            },
            "blog.tag": {
                "uri": "blog/tag/*",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\BlogController@tag",
                "description": "Public Blog tag archive."
            },
            "blog.show": {
                "uri": "blog/*",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "controller": "Modules\\Blog\\Http\\Controllers\\BlogController@show",
                "description": "Public Blog article."
            }
        },
        "controllers": {
            "Modules\\Blog\\Http\\Controllers\\Admin\\BlogAdminController": {
                "description": "Blog admin landing and settings controller."
            },
            "Modules\\Blog\\Http\\Controllers\\Admin\\PostController": {
                "description": "Blog post CRUD, editor, media, preview, autosave, revisions, and SEO controller."
            },
            "Modules\\Blog\\Http\\Controllers\\Admin\\CategoryController": {
                "description": "Blog category CRUD and quick-create controller."
            },
            "Modules\\Blog\\Http\\Controllers\\BlogController": {
                "description": "Public Blog frontend controller."
            }
        }
    },
    "permissions": [
        "blog.view",
        "blog.create",
        "blog.update",
        "blog.delete",
        "blog.publish",
        "blog.categories.manage",
        "blog.media.manage",
        "blog.revisions.restore"
    ],
    "menus": [
        {
            "key": "blog.admin",
            "name": "Blog",
            "location": "admin",
            "description": "SEO-ready article publishing workflow.",
            "source": "plugin",
            "sort_order": 65,
            "items": [
                {
                    "title": "Blog",
                    "label": "Blog",
                    "type": "route",
                    "route": "admin.plugins.blog.index",
                    "icon": "B",
                    "permission": "blog.view",
                    "sort_order": 65,
                    "children": [
                        {
                            "title": "Add New Post",
                            "label": "Add New Post",
                            "type": "route",
                            "route": "admin.plugins.blog.posts.create",
                            "permission": "blog.create",
                            "sort_order": 1
                        },
                        {
                            "title": "All Posts",
                            "label": "All Posts",
                            "type": "route",
                            "route": "admin.plugins.blog.posts.index",
                            "permission": "blog.view",
                            "sort_order": 2
                        },
                        {
                            "title": "Categories",
                            "label": "Categories",
                            "type": "route",
                            "route": "admin.plugins.blog.categories.index",
                            "permission": "blog.categories.manage",
                            "sort_order": 3
                        },
                        {
                            "title": "Add Category",
                            "label": "Add Category",
                            "type": "route",
                            "route": "admin.plugins.blog.categories.create",
                            "permission": "blog.categories.manage",
                            "sort_order": 4
                        }
                    ]
                }
            ]
        },
        {
            "key": "blog.frontend",
            "name": "Blog Menu",
            "location": "frontend",
            "description": "Public Blog navigation for the VvvebJs Frontend Menu element.",
            "source": "plugin",
            "sort_order": 30,
            "items": [
                {
                    "title": "Blog",
                    "label": "Blog",
                    "type": "route",
                    "route": "blog.index",
                    "icon": "newspaper",
                    "sort_order": 10,
                    "children": [
                        {
                            "title": "Categories",
                            "label": "Categories",
                            "type": "route",
                            "route": "blog.categories",
                            "sort_order": 10
                        }
                    ]
                }
            ]
        }
    ],
    "migrations": "database/migrations",
    "functions": {
        "blog.posts.create": {
            "description": "Create SEO-ready posts from the admin publishing screen.",
            "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@store"
        },
        "blog.posts.update": {
            "description": "Update editorial content, metadata, publishing state, featured image, tags, and SEO fields.",
            "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@update"
        },
        "blog.posts.publish": {
            "description": "Publish public SEO-ready posts.",
            "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@update"
        },
        "blog.posts.schedule": {
            "description": "Schedule public posts for future publication.",
            "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@update"
        },
        "blog.posts.preview": {
            "description": "Preview posts before public publication.",
            "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@preview"
        },
        "blog.posts.autosave": {
            "description": "Create autosave revisions for in-progress posts.",
            "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@autosave"
        },
        "blog.posts.revisions.restore": {
            "description": "Restore a stored post revision.",
            "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController@restoreRevision"
        },
        "blog.media.manage": {
            "description": "Upload, edit, delete, and insert media in posts.",
            "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\PostController"
        },
        "blog.categories.manage": {
            "description": "Manage post categories used by the publishing workflow.",
            "controller": "Modules\\Blog\\Http\\Controllers\\Admin\\CategoryController"
        }
    },
    "hooks": {
        "blog.post.saved": {
            "type": "action",
            "description": "Fires after a blog post is saved."
        },
        "blog.post.published": {
            "type": "action",
            "description": "Fires after a blog post becomes public."
        }
    },
    "uninstall": {
        "tables": [
            "blog_post_meta",
            "blog_post_revisions",
            "blog_media",
            "blog_category_post",
            "blog_post_tag",
            "blog_posts",
            "blog_tags",
            "blog_categories"
        ],
        "settings": [],
        "storage_paths": [
            {
                "disk": "public",
                "path": "blog"
            }
        ],
        "records": [],
        "columns": [],
        "operation_target_prefixes": []
    },
    "docs": "docs/plugin.md"
}
