    }

    .z4-mobile-menu-button {
        align-items: center;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: var(--ainpa-admin-radius-sm);
        border-color: rgba(255, 255, 255, 0.18) !important;
        color: #ffffff !important;
        cursor: pointer;
        display: inline-flex;
        font-size: 12px;
        font-weight: 800;
        min-height: 28px;
        padding: 4px 9px;
    }

    .ainpa-dashboard-page {
        padding: 22px 0;
    }

    .ainpa-page-container {
        padding-inline: 16px;
    }

    .ainpa-tool-grid {
        grid-template-columns: 1fr;
    }

    .admin-access-toolbar,
    .admin-access-accordion-button,
    .admin-modal-header {
        align-items: stretch;
        flex-direction: column;
    }

    .admin-access-panel,
    .admin-access-card-header,
    .admin-access-accordion-button {
        padding-left: 16px;
        padding-right: 16px;
    }

    .admin-access-count {
        white-space: normal;
    }

    .admin-access-form-grid,
    .admin-option-grid,
    .admin-option-grid-compact {
        grid-template-columns: 1fr;
    }

    .admin-modal-overlay {
        align-items: flex-start;
        padding: 14px;
    }

    .admin-modal-panel {
        max-height: calc(100vh - 28px);
    }

    .admin-modal-header,
    .admin-modal-footer,
    .admin-modal-body {
        padding-left: 16px;
        padding-right: 16px;
    }

    .admin-menu-page {
        padding: 22px 0;
    }

    .admin-menu-hero,
    .admin-menu-card-header,
    .admin-menu-source-main,
    .admin-menu-accordion-button,
    .admin-menu-builder-item {
        align-items: stretch;
        flex-direction: column;
    }

    .admin-menu-hero {
        padding: 20px;
    }

    .admin-menu-hero-stats,
    .admin-menu-tabs,
    .admin-menu-source-actions,
    .admin-menu-actions,
    .admin-menu-builder-actions {
        width: 100%;
    }

    .admin-menu-hero-stats,
    .admin-menu-source-grid,
    .admin-menu-form-grid-two,
    .admin-menu-form-grid-three,
    .admin-menu-form-grid-settings,
    .admin-menu-form-grid-four,
    .admin-menu-form-grid-six,
    .admin-menu-form-grid-action,
    .admin-menu-color-grid,
    .admin-menu-builder-grid {
        grid-template-columns: 1fr;
    }

    .admin-menu-source-grid,
    .admin-menu-card-edit,
    .admin-menu-panel,
    .admin-menu-card-header,
    .admin-menu-accordion-button,
    .admin-menu-builder-column {
        padding-left: 16px;
        padding-right: 16px;
    }

    .admin-menu-span-two {
        grid-column: auto;
    }

    .admin-menu-accordion-button {
        display: flex;
    }

    .admin-menu-level {
        display: none;
    }

    .admin-menu-item-meta {
        justify-content: flex-start;
    }

    .admin-menu-builder-column {
        border-right: 0;
        border-top: 1px solid var(--ainpa-admin-border);
    }

    .admin-menu-builder-column:first-child {
        border-top: 0;
    }
}

@media (min-width: 769px) and (max-width: 1100px) {
    .ainpa-tool-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .admin-option-grid,
    .admin-option-grid-compact {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .admin-menu-source-grid,
    .admin-menu-builder-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .admin-menu-form-grid-four,
    .admin-menu-color-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

