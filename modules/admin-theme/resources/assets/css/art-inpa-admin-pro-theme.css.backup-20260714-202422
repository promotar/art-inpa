/*
 * Art INPA Admin Pro Theme
 * Fast-edit tokens live here. Change these variables first for most visual tweaks.
 */
:root {
    --ainpa-admin-bg: #f6f2ef;
    --ainpa-admin-bg-soft: #fff8f3;
    --ainpa-admin-surface: #ffffff;
    --ainpa-admin-surface-soft: #fffaf7;
    --ainpa-admin-surface-blue: #fff1e8;
    --ainpa-admin-sidebar: #ffffff;
    --ainpa-admin-sidebar-deep: #fff7f1;
    --ainpa-admin-sidebar-line: rgba(176, 0, 0, 0.12);
    --ainpa-admin-topbar: #ffffff;
    --ainpa-admin-primary: #d71913;
    --ainpa-admin-primary-strong: #a80000;
    --ainpa-admin-primary-soft: #fff0ea;
    --ainpa-admin-primary-glow: rgba(255, 74, 0, 0.18);
    --ainpa-admin-accent: #ff4a00;
    --ainpa-admin-red: #b00000;
    --ainpa-admin-text: #17120f;
    --ainpa-admin-text-soft: #5f514b;
    --ainpa-admin-muted: #8a7870;
    --ainpa-admin-border: #eadbd4;
    --ainpa-admin-border-strong: #d8b8aa;
    --ainpa-admin-success: #11835b;
    --ainpa-admin-warning: #b7791f;
    --ainpa-admin-danger: #b00000;
    --ainpa-admin-radius: 8px;
    --ainpa-admin-radius-sm: 6px;
    --ainpa-admin-sidebar-width: 224px;
    --ainpa-admin-topbar-height: 34px;
    --ainpa-admin-shadow: 0 18px 42px rgba(80, 39, 22, 0.10);
    --ainpa-admin-shadow-soft: 0 10px 24px rgba(80, 39, 22, 0.08);
    --ainpa-admin-focus: 0 0 0 3px rgba(255, 74, 0, 0.18);
}

html {
    background: var(--ainpa-admin-bg);
}

body {
    background:
        radial-gradient(circle at top left, rgba(255, 74, 0, 0.10), transparent 34rem),
        linear-gradient(180deg, #ffffff 0%, var(--ainpa-admin-bg) 42%, #f2ece7 100%);
    color: var(--ainpa-admin-text);
    letter-spacing: 0;
}

body,
button,
input,
select,
textarea {
    font-feature-settings: "kern";
}

.min-h-screen.bg-gray-100 {
    background: #f6f2ef !important;
    min-height: 100vh;
}

@media (min-width: 769px) {
    body .min-h-screen.bg-gray-100 {
        padding-left: var(--ainpa-admin-sidebar-width) !important;
        padding-top: var(--ainpa-admin-topbar-height) !important;
    }
}

/* Top admin bar */
.z4-admin-bar {
    align-items: center;
    background:
        linear-gradient(90deg, var(--ainpa-admin-topbar), #0b1f38 58%, #103a68) !important;
    border-bottom: 1px solid rgba(148, 180, 220, 0.16);
    box-shadow: 0 8px 22px rgba(1, 8, 20, 0.22);
    color: #f0f0f1;
    display: flex;
    height: var(--ainpa-admin-topbar-height) !important;
    justify-content: space-between;
    left: 0;
    padding-inline: 16px !important;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 1000;
}

.z4-admin-bar a,
.z4-admin-bar button {
    color: #d9e9fb !important;
}

.z4-admin-bar a:hover,
.z4-admin-bar button:hover {
    color: #ffffff !important;
}

.z4-admin-bar svg,
.z4-admin-bar img {
    filter: drop-shadow(0 2px 6px rgba(29, 111, 216, 0.20));
}

.z4-admin-bar-main,
.z4-admin-bar-actions {
    align-items: center;
    display: flex;
    gap: 16px;
    height: 100%;
}

.z4-admin-brand,
.z4-admin-home-link,
.z4-admin-profile-link,
.z4-admin-bar-button {
    align-items: center;
    background: transparent;
    border: 0;
    display: inline-flex;
    gap: 8px;
    height: 100%;
    text-decoration: none;
}

.z4-admin-brand {
    font-size: 13px;
    font-weight: 800;
}

.z4-admin-brand-logo {
    display: block;
    height: 20px;
    width: auto;
}

.z4-admin-home-link,
.z4-admin-profile-link,
.z4-admin-bar-button {
    font-size: 12px;
}

.z4-admin-bar-button {
    cursor: pointer;
    padding: 0;
}

.z4-admin-logout-form,
.z4-admin-footer-form {
    margin: 0;
}

/* Sidebar */
.z4-admin-sidebar {
    background:
        linear-gradient(180deg, var(--ainpa-admin-sidebar), var(--ainpa-admin-sidebar-deep)) !important;
    border-right: 1px solid var(--ainpa-admin-sidebar-line);
    bottom: 0;
    box-shadow: 18px 0 42px rgba(1, 8, 20, 0.28);
    color: #f0f0f1;
    display: flex !important;
    flex-direction: column;
    left: 0;
    position: fixed;
    top: var(--ainpa-admin-topbar-height) !important;
    width: var(--ainpa-admin-sidebar-width) !important;
    z-index: 900;
}

.z4-admin-sidebar-scroll {
    padding: 10px 8px !important;
}

.z4-admin-sidebar-footer {
    border-top: 1px solid var(--ainpa-admin-sidebar-line) !important;
    padding: 8px !important;
}

.z4-admin-menu-group {
    margin-bottom: 3px;
}

.z4-admin-section {
    border-bottom: 1px solid rgba(148, 180, 220, 0.08);
    padding: 5px 0;
}

.z4-admin-section-toggle {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: var(--ainpa-admin-radius-sm);
    color: #8fa7c4 !important;
    cursor: pointer;
    display: flex;
    font-size: 11px;
    font-weight: 900;
    gap: 8px;
    letter-spacing: 0.03em;
    min-height: 34px;
    padding: 7px 8px;
    text-align: left;
    text-transform: uppercase;
    width: 100%;
}

.z4-admin-section-toggle:hover,
.z4-admin-section.is-active > .z4-admin-section-toggle {
    background: rgba(75, 139, 212, 0.13);
    color: #ffffff !important;
}

.z4-admin-section-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.z4-admin-chevron {
    border-bottom: 2px solid currentColor;
    border-right: 2px solid currentColor;
    display: inline-block;
    height: 7px;
    transform: rotate(45deg);
    transition: transform 140ms ease;
    width: 7px;
}

.z4-admin-section.is-open > .z4-admin-section-toggle .z4-admin-chevron,
.z4-admin-menu-group.is-open .z4-admin-submenu-toggle .z4-admin-chevron {
    transform: rotate(225deg);
}

.z4-admin-section-body {
    display: grid;
    gap: 2px;
    padding: 2px 0 4px;
}

.z4-admin-link {
    align-items: center;
    border-radius: var(--ainpa-admin-radius-sm);
    color: #c7d8eb !important;
    display: flex;
    font-size: 13px !important;
    gap: 8px;
    min-height: 38px !important;
    padding: 9px 10px !important;
    text-decoration: none;
    transition:
        background-color 150ms ease,
        color 150ms ease,
        transform 150ms ease,
        box-shadow 150ms ease;
}

.z4-admin-link:hover {
    background: rgba(75, 139, 212, 0.16) !important;
    color: #ffffff !important;
    transform: translateX(2px);
}

.z4-admin-link.is-active {
    background:
        linear-gradient(135deg, var(--ainpa-admin-primary), var(--ainpa-admin-primary-strong)) !important;
    box-shadow: 0 10px 22px rgba(29, 111, 216, 0.28);
    color: #ffffff !important;
}

.z4-admin-icon {
    background: rgba(255, 255, 255, 0.09) !important;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px !important;
    color: #eaf4ff;
    height: 24px !important;
    width: 24px !important;
}

.z4-admin-link.is-active .z4-admin-icon {
    background: rgba(255, 255, 255, 0.18) !important;
}

.z4-admin-link-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.z4-admin-parent-row {
    align-items: stretch;
    display: flex;
    gap: 4px;
}

.z4-admin-parent-link {
    flex: 1;
}

.z4-admin-submenu-toggle {
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--ainpa-admin-radius-sm);
    color: #aebfd3;
    cursor: pointer;
    display: inline-flex;
    justify-content: center;
    margin: 3px 0;
    width: 30px;
}

.z4-admin-submenu-toggle:hover {
    background: rgba(75, 139, 212, 0.16);
    color: #ffffff;
}

.z4-admin-submenu {
    background: rgba(0, 0, 0, 0.18) !important;
    border-left: 1px solid rgba(29, 111, 216, 0.26);
    border-radius: 0 0 var(--ainpa-admin-radius-sm) var(--ainpa-admin-radius-sm);
    margin: -2px 7px 6px 17px !important;
    padding: 6px 0 !important;
}

.z4-admin-submenu-link {
    border-radius: 5px;
    color: #aebfd3 !important;
    font-size: 12px !important;
    margin: 1px 6px;
    padding: 7px 8px 7px 18px !important;
}

.z4-admin-submenu-link:hover,
.z4-admin-submenu-link.is-active {
    background: rgba(29, 111, 216, 0.12);
    color: #ffffff !important;
}

/* Sidebar hierarchy polish: clearer group separation and parent/child distinction. */
.z4-admin-sidebar .z4-admin-sidebar-scroll {
    padding: 12px 10px !important;
}

.z4-admin-sidebar .z4-admin-section {
    border-bottom: 1px solid rgba(148, 180, 220, 0.12) !important;
    margin: 0 0 8px !important;
    padding: 0 0 10px !important;
}

.z4-admin-sidebar .z4-admin-section:last-child {
    border-bottom: 0 !important;
}

.z4-admin-sidebar .z4-admin-section-toggle {
    background: rgba(255, 255, 255, 0.035) !important;
    border: 1px solid rgba(148, 180, 220, 0.10) !important;
    border-radius: 8px !important;
    color: #9fb5cf !important;
    font-size: 11px !important;
    gap: 10px !important;
    letter-spacing: 0.04em !important;
    min-height: 38px !important;
    padding: 8px 10px !important;
}

.z4-admin-sidebar .z4-admin-section-toggle:hover,
.z4-admin-sidebar .z4-admin-section.is-active > .z4-admin-section-toggle {
    background: rgba(29, 111, 216, 0.16) !important;
    border-color: rgba(74, 144, 226, 0.30) !important;
    color: #ffffff !important;
}

.z4-admin-sidebar .z4-admin-section-body {
    display: grid !important;
    gap: 5px !important;
    padding: 9px 0 0 !important;
}

.z4-admin-sidebar .z4-admin-link {
    border: 1px solid transparent !important;
    border-radius: 8px !important;
    color: #d3e1f2 !important;
    font-size: 13px !important;
    gap: 10px !important;
    min-height: 42px !important;
    padding: 9px 10px !important;
}

.z4-admin-sidebar .z4-admin-link:hover {
    background: rgba(75, 139, 212, 0.14) !important;
    border-color: rgba(148, 180, 220, 0.13) !important;
    color: #ffffff !important;
    transform: translateX(2px);
}

.z4-admin-sidebar .z4-admin-link.is-active {
    background:
        linear-gradient(135deg, #2576db, #1557b0) !important;
    border-color: rgba(255, 255, 255, 0.14) !important;
    box-shadow: 0 10px 24px rgba(29, 111, 216, 0.30) !important;
    color: #ffffff !important;
}

.z4-admin-sidebar .z4-admin-icon {
    border-radius: 7px !important;
    flex: 0 0 26px !important;
    font-size: 11px !important;
    height: 26px !important;
    width: 26px !important;
}

.z4-admin-sidebar .z4-admin-parent-row {
    align-items: stretch !important;
    background: rgba(255, 255, 255, 0.025) !important;
    border: 1px solid rgba(148, 180, 220, 0.10) !important;
    border-radius: 9px !important;
    gap: 5px !important;
    padding: 3px !important;
}

.z4-admin-sidebar .z4-admin-parent-row .z4-admin-parent-link {
    border-radius: 7px !important;
    min-height: 40px !important;
    padding: 8px 9px !important;
}

.z4-admin-sidebar .z4-admin-parent-row .z4-admin-parent-link.is-active {
    background:
        linear-gradient(135deg, #2576db, #1557b0) !important;
}

.z4-admin-sidebar .z4-admin-submenu-toggle {
    border-radius: 7px !important;
    flex: 0 0 34px !important;
    margin: 0 !important;
    min-height: 40px !important;
    width: 34px !important;
}

.z4-admin-sidebar .z4-admin-submenu {
    background: rgba(2, 8, 23, 0.36) !important;
    border-left: 2px solid rgba(74, 144, 226, 0.35) !important;
    border-radius: 0 0 9px 9px !important;
    display: grid !important;
    gap: 3px !important;
    margin: 3px 8px 10px 20px !important;
    padding: 7px 0 7px 10px !important;
}

.z4-admin-sidebar .z4-admin-submenu-link {
    border-radius: 7px !important;
    color: #b9cce3 !important;
    display: flex !important;
    font-size: 12px !important;
    line-height: 1.3 !important;
    margin: 0 !important;
    min-height: 32px !important;
    padding: 8px 9px !important;
    text-decoration: none !important;
}

.z4-admin-sidebar .z4-admin-submenu-link::before {
    background: rgba(148, 180, 220, 0.50);
    border-radius: 999px;
    content: "";
    flex: 0 0 5px;
    height: 5px;
    margin: 6px 8px 0 0;
    width: 5px;
}

.z4-admin-sidebar .z4-admin-submenu-link:hover,
.z4-admin-sidebar .z4-admin-submenu-link.is-active {
    background: rgba(29, 111, 216, 0.18) !important;
    color: #ffffff !important;
}

.z4-admin-sidebar .z4-admin-submenu-link.is-active::before {
    background: #ffffff;
}

/* Closed sidebar groups open as side flyouts on hover; clicked/active groups stay inline. */
.z4-admin-sidebar .z4-admin-section {
    position: relative;
}

.z4-admin-sidebar .z4-admin-section:not(.is-open) > .z4-admin-section-body {
    display: none !important;
}

.z4-admin-sidebar .z4-admin-section:not(.is-open):hover > .z4-admin-section-body {
    background:
        linear-gradient(180deg, rgba(7, 17, 31, 0.98), rgba(2, 8, 23, 0.98)) !important;
    border: 1px solid rgba(148, 180, 220, 0.18) !important;
    border-radius: 12px !important;
    box-shadow: 22px 24px 54px rgba(1, 8, 20, 0.38) !important;
    display: grid !important;
    gap: 6px !important;
    left: calc(100% + 12px);
    min-width: 250px;
    padding: 10px !important;
    position: absolute;
    top: 0;
    width: max-content;
    max-width: 310px;
    z-index: 1250;
}

.z4-admin-sidebar .z4-admin-section:not(.is-open):hover > .z4-admin-section-body::before {
    border-bottom: 8px solid transparent;
    border-right: 8px solid rgba(7, 17, 31, 0.98);
    border-top: 8px solid transparent;
    content: "";
    left: -8px;
    position: absolute;
    top: 14px;
}

.z4-admin-sidebar .z4-admin-section:not(.is-open):hover > .z4-admin-section-toggle {
    background: rgba(29, 111, 216, 0.16) !important;
    border-color: rgba(74, 144, 226, 0.34) !important;
    color: #ffffff !important;
}

.z4-admin-sidebar .z4-admin-section:not(.is-open):hover > .z4-admin-section-toggle .z4-admin-chevron {
    transform: rotate(-45deg);
}

.z4-admin-sidebar .z4-admin-section:not(.is-open):hover .z4-admin-link {
    min-height: 38px !important;
}

.z4-admin-sidebar .z4-admin-section:not(.is-open):hover .z4-admin-menu-group {
    position: relative;
}

.z4-admin-sidebar .z4-admin-section:not(.is-open):hover .z4-admin-parent-row {
    background: transparent !important;
}

.z4-admin-sidebar .z4-admin-menu-group:not(.is-open) > .z4-admin-submenu {
    display: none !important;
}

.z4-admin-sidebar .z4-admin-menu-group:not(.is-open):hover > .z4-admin-submenu {
    background:
        linear-gradient(180deg, rgba(7, 17, 31, 0.98), rgba(2, 8, 23, 0.98)) !important;
    border: 1px solid rgba(148, 180, 220, 0.18) !important;
    border-left: 2px solid rgba(74, 144, 226, 0.45) !important;
    border-radius: 12px !important;
    box-shadow: 20px 22px 48px rgba(1, 8, 20, 0.35) !important;
    display: grid !important;
    gap: 4px !important;
    left: calc(100% + 10px);
    margin: 0 !important;
    min-width: 220px;
    padding: 9px 10px !important;
    position: absolute;
    top: 0;
    z-index: 1260;
}

.z4-admin-sidebar .z4-admin-section.is-open .z4-admin-menu-group.is-open > .z4-admin-submenu {
    display: grid !important;
    position: static;
}

.z4-admin-sidebar .z4-admin-section.is-open .z4-admin-menu-group:not(.is-open):hover > .z4-admin-submenu {
    left: calc(100% + 12px);
    top: 0;
}

.z4-admin-sidebar .z4-admin-section:not(.is-open):hover .z4-admin-submenu-toggle .z4-admin-chevron,
.z4-admin-sidebar .z4-admin-menu-group:not(.is-open):hover .z4-admin-submenu-toggle .z4-admin-chevron {
    transform: rotate(-45deg);
}

.z4-admin-footer-button {
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: left;
    width: 100%;
}

.z4-builder-sidebar-toggle {
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--ainpa-admin-radius-sm);
    color: #d9e9fb;
    cursor: pointer;
    display: none;
    font-size: 12px;
    font-weight: 800;
    min-height: 24px;
    padding: 3px 9px;
}

.z4-builder-sidebar-toggle:hover {
    background: var(--ainpa-admin-primary);
    border-color: #72aee6;
    color: #ffffff;
}

.page-builder-focus-body {
    --ainpa-admin-sidebar-width: 48px;
    --pb-admin-sidebar-width: 48px;
}

.page-builder-focus-body.page-builder-sidebar-expanded {
    --ainpa-admin-sidebar-width: 224px;
    --pb-admin-sidebar-width: 224px;
}

.page-builder-focus-body .z4-builder-sidebar-toggle {
    display: inline-flex;
}

.page-builder-focus-body .z4-admin-sidebar {
    transition: width 160ms ease;
    width: 48px !important;
}

.page-builder-focus-body.page-builder-sidebar-expanded .z4-admin-sidebar {
    width: 224px !important;
}

.page-builder-focus-body.page-builder-sidebar-compact .z4-admin-section-toggle,
.page-builder-focus-body.page-builder-sidebar-compact .z4-admin-link {
    gap: 0;
    justify-content: center;
    padding-left: 0 !important;
    padding-right: 0 !important;
}

.page-builder-focus-body.page-builder-sidebar-compact .z4-admin-section-label,
.page-builder-focus-body.page-builder-sidebar-compact .z4-admin-link-label,
.page-builder-focus-body.page-builder-sidebar-compact .z4-admin-chevron,
.page-builder-focus-body.page-builder-sidebar-compact .z4-admin-submenu,
.page-builder-focus-body.page-builder-sidebar-compact .z4-admin-sidebar-footer {
    display: none;
}

.page-builder-focus-body .page-builder-main,
.page-builder-focus-body .page-builder-focus-main {
    left: 48px !important;
    transition: left 160ms ease;
}

.page-builder-focus-body.page-builder-sidebar-expanded .page-builder-main,
.page-builder-focus-body.page-builder-sidebar-expanded .page-builder-focus-main {
    left: 224px !important;
}

[x-cloak] {
    display: none !important;
}

.z4-mobile-menu-button,
.z4-mobile-drawer,
.z4-mobile-overlay {
    display: none;
}

/* Page shell and headings */
header.bg-white {
    background:
        linear-gradient(180deg, #ffffff, #f8fbff) !important;
    border-bottom: 1px solid var(--ainpa-admin-border);
    box-shadow: var(--ainpa-admin-shadow-soft) !important;
}

header h1,
header h2,
main h1,
main h2,
main h3,
main h4 {
    color: #0b1728 !important;
    letter-spacing: 0;
}

main {
    color: var(--ainpa-admin-text);
}

main > .py-8,
main > .py-10,
.themes-page,
.pp-dashboard-page {
    background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.80), rgba(243, 247, 251, 0.95));
}

.mx-auto.max-w-7xl,
.mx-auto.max-w-6xl,
.mx-auto.max-w-5xl {
    max-width: 1320px;
}

/* Semantic admin layout primitives */
.ainpa-admin-page {
    background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.80), rgba(243, 247, 251, 0.95));
    min-height: calc(100vh - var(--ainpa-admin-topbar-height));
    padding: 32px 0;
}

.ainpa-page-toolbar {
    align-items: center;
    display: flex;
    gap: 16px;
    justify-content: space-between;
}

.ainpa-page-container {
    margin-inline: auto;
    max-width: 1320px;
    padding-inline: 24px;
    width: 100%;
}

.ainpa-page-container > * + * {
    margin-top: 24px;
}

.ainpa-page-title {
    color: #0b1728;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.25;
    margin: 0;
}

/* Surfaces */
main .bg-white,
main .rounded,
main .rounded-md,
main .rounded-lg,
main .shadow,
main .shadow-sm,
main form.bg-white,
main section.bg-white,
main aside.bg-white,
main .overflow-hidden {
    border-color: var(--ainpa-admin-border) !important;
    border-radius: var(--ainpa-admin-radius) !important;
}

main .bg-white,
main form.bg-white,
main section.bg-white,
main aside.bg-white,
main .shadow,
main .shadow-sm {
    box-shadow: var(--ainpa-admin-shadow-soft) !important;
}

main .border,
main .border-gray-100,
main .border-gray-200,
main .border-gray-300 {
    border-color: var(--ainpa-admin-border) !important;
}

main .text-gray-400,
main .text-gray-500,
main .text-gray-600,
main small,
main p {
    color: var(--ainpa-admin-text-soft) !important;
}

main .font-mono {
    color: #24364d;
}

.ainpa-card {
    background: #ffffff;
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius);
    box-shadow: var(--ainpa-admin-shadow-soft);
}

/* Buttons and links */
main a {
    color: var(--ainpa-admin-primary);
}

main a:hover {
    color: var(--ainpa-admin-primary-strong);
}

main button,
main a[role="button"],
main .btn,
main input[type="submit"] {
    border-radius: var(--ainpa-admin-radius-sm) !important;
    transition:
        background-color 140ms ease,
        border-color 140ms ease,
        box-shadow 140ms ease,
        transform 140ms ease;
}

main button:hover,
main a[role="button"]:hover,
main input[type="submit"]:hover {
    transform: translateY(-1px);
}

main .bg-blue-600,
main .bg-indigo-600,
main .themes-primary-button,
main button[type="submit"],
main a[href*="create"].bg-gray-900,
main .bg-gray-900.text-white {
    background:
        linear-gradient(135deg, var(--ainpa-admin-primary), var(--ainpa-admin-primary-strong)) !important;
    border-color: var(--ainpa-admin-primary-strong) !important;
    box-shadow: 0 9px 18px rgba(29, 111, 216, 0.20);
    color: #ffffff !important;
}

main .bg-blue-600:hover,
main .bg-indigo-600:hover,
main .themes-primary-button:hover,
main button[type="submit"]:hover {
    background:
        linear-gradient(135deg, #247de8, var(--ainpa-admin-primary)) !important;
}

main .border-blue-200,
main .text-blue-700,
main .text-blue-800 {
    border-color: #b8d6fb !important;
    color: var(--ainpa-admin-primary-strong) !important;
}

.ainpa-button {
    align-items: center;
    border: 1px solid transparent;
    border-radius: var(--ainpa-admin-radius-sm);
    cursor: pointer;
    display: inline-flex;
    font-size: 13px;
    font-weight: 800;
    justify-content: center;
    line-height: 1.2;
    min-height: 38px;
    padding: 10px 14px;
    text-decoration: none;
    transition:
        background-color 140ms ease,
        border-color 140ms ease,
        box-shadow 140ms ease,
        color 140ms ease,
        transform 140ms ease;
    white-space: nowrap;
}

.ainpa-button:hover {
    transform: translateY(-1px);
}

.ainpa-button-primary {
    background:
        linear-gradient(135deg, var(--ainpa-admin-primary), var(--ainpa-admin-primary-strong));
    border-color: var(--ainpa-admin-primary-strong);
    box-shadow: 0 9px 18px rgba(29, 111, 216, 0.20);
    color: #ffffff;
}

.ainpa-button-primary:hover {
    background:
        linear-gradient(135deg, #247de8, var(--ainpa-admin-primary));
    color: #ffffff;
}

.ainpa-button-success {
    background: #eafaf3;
    border-color: #b7ead2;
    color: var(--ainpa-admin-success);
}

.ainpa-button-success:hover {
    background: #d9f5e8;
    color: #0b6a49;
}

.ainpa-button-danger {
    background: #fff1f2;
    border-color: #f3c4cb;
    color: var(--ainpa-admin-danger);
}

.ainpa-button-danger:hover {
    background: #ffe4e8;
    color: #9f2f39;
}

.ainpa-button-compact {
    font-size: 12px;
    min-height: 32px;
    padding: 8px 11px;
}

/* Forms */
input,
select,
textarea {
    background: #ffffff !important;
    border-color: #c8d6e6 !important;
    border-radius: var(--ainpa-admin-radius-sm) !important;
    color: var(--ainpa-admin-text) !important;
}

main input[type="checkbox"],
main input[type="radio"] {
    -webkit-appearance: none !important;
    appearance: none !important;
    background-color: #ffffff !important;
    border: 1px solid #b9c9dc !important;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.72);
    color: var(--ainpa-admin-primary) !important;
    display: inline-grid;
    flex: 0 0 auto;
    height: 18px;
    margin: 0;
    place-content: center;
    vertical-align: middle;
    width: 18px;
}

main input[type="checkbox"] {
    border-radius: 4px !important;
}

main input[type="radio"] {
    border-radius: 999px !important;
}

main input[type="checkbox"]::before,
main input[type="radio"]::before {
    content: "";
    transform: scale(0);
    transition: transform 120ms ease;
}

main input[type="checkbox"]::before {
    background: #ffffff;
    clip-path: polygon(14% 50%, 0 64%, 39% 100%, 100% 18%, 84% 4%, 36% 68%);
    height: 10px;
    width: 10px;
}

main input[type="radio"]::before {
    background: var(--ainpa-admin-primary);
    border-radius: 999px;
    height: 8px;
    width: 8px;
}

main input[type="checkbox"]:checked {
    background: var(--ainpa-admin-primary) !important;
    border-color: var(--ainpa-admin-primary-strong) !important;
}

main input[type="checkbox"]:checked::before,
main input[type="radio"]:checked::before {
    transform: scale(1);
}

main input[type="checkbox"]:focus,
main input[type="radio"]:focus {
    border-color: var(--ainpa-admin-primary) !important;
    box-shadow: var(--ainpa-admin-focus) !important;
    outline: none !important;
}

main input[type="checkbox"]:disabled,
main input[type="radio"]:disabled {
    background: #eef2f7 !important;
    border-color: #d5dfeb !important;
    cursor: not-allowed;
    opacity: 0.72;
}

input::placeholder,
textarea::placeholder {
    color: #8797aa !important;
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--ainpa-admin-primary) !important;
    box-shadow: var(--ainpa-admin-focus) !important;
    outline: none !important;
}

label,
main .themes-label {
    color: #17243a !important;
    font-weight: 700;
}

/* Tables */
table {
    border-collapse: separate;
    border-spacing: 0;
}

table thead,
main .bg-gray-50 {
    background:
        linear-gradient(180deg, #eef6ff, #e8f1fb) !important;
}

table th {
    color: #17345b !important;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
}

table td,
table th {
    border-color: var(--ainpa-admin-border) !important;
}

tbody tr {
    transition: background-color 120ms ease;
}

tbody tr:hover {
    background: #f7fbff;
}

.ainpa-table-card {
    overflow-x: auto;
}

.ainpa-data-table {
    border-collapse: separate;
    border-spacing: 0;
    font-size: 13px;
    min-width: 100%;
    width: 100%;
}

.ainpa-data-table thead {
    background:
        linear-gradient(180deg, #eef6ff, #e8f1fb);
}

.ainpa-data-table th {
    color: #17345b;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.03em;
    padding: 13px 14px;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
}

.ainpa-data-table td {
    border-top: 1px solid var(--ainpa-admin-border);
    color: var(--ainpa-admin-text);
    padding: 14px;
    vertical-align: top;
}

.ainpa-data-table tbody tr {
    transition: background-color 120ms ease;
}

.ainpa-data-table tbody tr:hover {
    background: #f7fbff;
}

.ainpa-table-primary {
    color: #0b1728;
    font-weight: 800;
}

.ainpa-table-muted,
.ainpa-table-note,
.ainpa-table-path {
    color: var(--ainpa-admin-text-soft);
    font-size: 12px;
}

.ainpa-table-note-title {
    color: #17243a;
    display: block;
    font-weight: 800;
    margin-bottom: 3px;
}

.ainpa-table-link {
    color: var(--ainpa-admin-primary-strong);
    font-weight: 800;
    text-decoration: none;
}

.ainpa-table-link:hover {
    color: var(--ainpa-admin-primary);
    text-decoration: underline;
}

.ainpa-table-path {
    max-width: 260px;
    word-break: break-word;
}

.ainpa-table-actions {
    white-space: nowrap;
}

.ainpa-action-form {
    margin: 0;
}

.ainpa-code {
    color: #24364d;
    font-family:
        ui-monospace,
        SFMono-Regular,
        Menlo,
        Monaco,
        Consolas,
        "Liberation Mono",
        "Courier New",
        monospace;
    font-size: 12px;
    word-break: break-word;
}

.ainpa-status-badge {
    border: 1px solid transparent;
    border-radius: 999px;
    display: inline-flex;
    font-size: 11px;
    font-weight: 900;
    line-height: 1;
    padding: 6px 9px;
    text-transform: uppercase;
    white-space: nowrap;
}

.ainpa-status-active {
    background: #eafaf3;
    border-color: #b7ead2;
    color: var(--ainpa-admin-success);
}

.ainpa-status-inactive {
    background: #eef2f7;
    border-color: #d5dfeb;
    color: #52647b;
}

.ainpa-empty-table {
    color: var(--ainpa-admin-text-soft);
    padding: 26px;
    text-align: center;
}

/* Status colors and alerts */
.ainpa-alert {
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius);
    font-size: 14px;
    line-height: 1.5;
    padding: 12px 16px;
}

.ainpa-alert-warning {
    background: #fff8e5;
    border-color: #f0d89c;
    color: var(--ainpa-admin-warning);
}

.ainpa-alert-success {
    background: #ecfdf5;
    border-color: #b7ead2;
    color: var(--ainpa-admin-success);
}

.ainpa-alert-danger {
    background: #fff1f2;
    border-color: #f3c4cb;
    color: var(--ainpa-admin-danger);
}

/* Users and roles access management */
.admin-access-page {
    --admin-access-panel-width: 920px;
}

.admin-access-toolbar {
    align-items: center;
    background:
        linear-gradient(180deg, #ffffff, #f8fbff);
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius);
    box-shadow: var(--ainpa-admin-shadow-soft);
    display: flex;
    gap: 18px;
    justify-content: space-between;
    padding: 20px 24px;
}

.admin-access-title,
.admin-access-card-title,
.admin-modal-title {
    color: #0b1728;
    font-weight: 800;
    line-height: 1.25;
    margin: 0;
}

.admin-access-title {
    font-size: 18px;
}

.admin-access-subtitle,
.admin-modal-subtitle,
.admin-field-hint,
.admin-access-note {
    color: var(--ainpa-admin-text-soft);
    font-size: 13px;
    line-height: 1.55;
    margin: 6px 0 0;
}

.admin-access-card {
    background: #ffffff;
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius);
    box-shadow: var(--ainpa-admin-shadow-soft);
    overflow: hidden;
}

.admin-access-card-header {
    border-bottom: 1px solid var(--ainpa-admin-border);
    padding: 16px 24px;
}

.admin-access-card-title,
.admin-modal-title {
    font-size: 18px;
}

.admin-access-accordion {
    display: grid;
}

.admin-access-accordion-item + .admin-access-accordion-item {
    border-top: 1px solid var(--ainpa-admin-border);
}

.admin-access-accordion-button {
    align-items: center;
    background: #ffffff;
    border: 0;
    color: var(--ainpa-admin-text);
    cursor: pointer;
    display: flex;
    gap: 16px;
    justify-content: space-between;
    min-height: 66px;
    padding: 16px 24px;
    text-align: left;
    width: 100%;
}

.admin-access-accordion-button:hover,
.admin-access-accordion-button[aria-expanded="true"] {
    background: #f7fbff;
}

.admin-access-entity {
    display: grid;
    gap: 4px;
    min-width: 0;
}

.admin-access-entity-name {
    color: #0b1728;
    font-size: 14px;
    font-weight: 800;
    overflow-wrap: anywhere;
}

.admin-access-entity-meta,
.admin-access-count {
    color: var(--ainpa-admin-text-soft);
    font-size: 12px;
}

.admin-access-count {
    flex: 0 0 auto;
    font-weight: 800;
    white-space: nowrap;
}

.admin-access-panel {
    background: #fbfdff;
    border-top: 1px solid var(--ainpa-admin-border);
    padding: 22px 24px;
}

.admin-access-form,
.admin-access-stack {
    display: grid;
    gap: 18px;
}

.admin-access-form-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.admin-field {
    display: grid;
    gap: 7px;
}

.admin-field-label {
    color: #17243a;
    display: block;
    font-size: 13px;
    font-weight: 800;
}

.admin-input {
    background: #ffffff !important;
    border: 1px solid #c8d6e6 !important;
    border-radius: var(--ainpa-admin-radius-sm) !important;
    color: var(--ainpa-admin-text) !important;
    min-height: 42px;
    padding: 9px 11px;
    width: 100%;
}

.admin-input:focus {
    border-color: var(--ainpa-admin-primary) !important;
    box-shadow: var(--ainpa-admin-focus) !important;
    outline: none !important;
}

.admin-option-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 8px;
}

.admin-option-grid-compact {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.admin-option {
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius);
    display: flex;
    gap: 9px;
    min-width: 0;
    padding: 10px 12px;
}

.admin-option span {
    color: #1f2937;
    font-family:
        ui-monospace,
        SFMono-Regular,
        Menlo,
        Monaco,
        Consolas,
        "Liberation Mono",
        monospace;
    font-size: 12px;
    overflow-wrap: anywhere;
}

.admin-access-actions,
.admin-danger-form {
    display: flex;
    justify-content: flex-end;
}

.admin-danger-zone {
    border-top: 1px solid var(--ainpa-admin-border);
    margin-top: 20px;
    padding-top: 16px;
}

.admin-modal-overlay {
    align-items: center;
    background: rgba(15, 23, 42, 0.62);
    box-sizing: border-box;
    display: flex;
    inset: 0;
    justify-content: center;
    overflow-y: auto;
    padding: 24px;
    position: fixed;
    z-index: 10050;
}

.admin-modal-backdrop {
    inset: 0;
    position: fixed;
    z-index: 0;
}

.admin-modal-panel {
    background: #ffffff;
    border: 1px solid var(--ainpa-admin-border);
    border-radius: 12px;
    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.28);
    display: flex;
    flex-direction: column;
    max-height: min(88vh, 840px);
    max-width: var(--admin-access-panel-width);
    overflow: hidden;
    position: relative;
    width: min(var(--admin-access-panel-width), 100%);
    z-index: 1;
}

.admin-modal-header {
    align-items: flex-start;
    border-bottom: 1px solid var(--ainpa-admin-border);
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding: 18px 24px;
}

.admin-modal-close {
    background: transparent;
    border: 0;
    border-radius: var(--ainpa-admin-radius-sm);
    color: var(--ainpa-admin-text-soft);
    cursor: pointer;
    font-size: 14px;
    font-weight: 800;
    padding: 8px 10px;
}

.admin-modal-close:hover {
    background: #f1f5f9;
    color: #111827;
}

.admin-modal-form {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
}

.admin-modal-body {
    display: grid;
    gap: 20px;
    overflow-y: auto;
    padding: 22px 24px;
}

.admin-modal-footer {
    align-items: center;
    background: #f8fafc;
    border-top: 1px solid var(--ainpa-admin-border);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
    padding: 16px 24px;
}

.admin-modal-cancel {
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: var(--ainpa-admin-radius-sm);
    color: #374151;
    cursor: pointer;
    font-size: 14px;
    font-weight: 800;
    padding: 9px 16px;
}

.admin-modal-cancel:hover {
    background: #f8fafc;
}

main .bg-green-50,
main .border-green-200 {
    background: #ecfdf5 !important;
    border-color: #b7ead2 !important;
    color: var(--ainpa-admin-success) !important;
}

main .bg-red-50,
main .border-red-200 {
    background: #fff1f2 !important;
    border-color: #f3c4cb !important;
    color: var(--ainpa-admin-danger) !important;
}

main .bg-yellow-50,
main .border-yellow-200 {
    background: #fff8e5 !important;
    border-color: #f0d89c !important;
    color: var(--ainpa-admin-warning) !important;
}

main .text-green-700,
main .text-green-800 {
    color: var(--ainpa-admin-success) !important;
}

main .text-red-600,
main .text-red-700,
main .text-red-800 {
    color: var(--ainpa-admin-danger) !important;
}

/* Plugin-specific admin pages */
.themes-card,
.pp-card,
.ai-assistant-settings-card {
    border: 1px solid var(--ainpa-admin-border) !important;
    border-radius: var(--ainpa-admin-radius) !important;
    box-shadow: var(--ainpa-admin-shadow-soft) !important;
}

.themes-tabs {
    border-color: var(--ainpa-admin-border-strong) !important;
}

.themes-tab {
    border-radius: var(--ainpa-admin-radius-sm) var(--ainpa-admin-radius-sm) 0 0;
    color: var(--ainpa-admin-primary-strong) !important;
}

.themes-tab.is-active {
    background: #ffffff !important;
    border-color: var(--ainpa-admin-border-strong) !important;
    color: #07111f !important;
}

.themes-secondary-button {
    border-color: var(--ainpa-admin-border-strong) !important;
    color: #21354f !important;
}

/* Dashboard widgets */
.ainpa-dashboard-page {
    padding: 32px 0;
}

.ainpa-dashboard-hero,
.ainpa-empty-state {
    background: #ffffff;
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius);
    box-shadow: var(--ainpa-admin-shadow-soft);
    padding: 24px;
}

.ainpa-section-title {
    color: #0b1728;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.35;
    margin: 0;
}

.ainpa-section-description {
    color: var(--ainpa-admin-text-soft);
    font-size: 14px;
    line-height: 1.6;
    margin: 6px 0 0;
}

.ainpa-empty-state {
    color: #334258;
    font-size: 14px;
    line-height: 1.6;
}

.ainpa-tool-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.ainpa-tool-card {
    background:
        linear-gradient(180deg, #ffffff, #f8fbff);
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius);
    box-shadow: var(--ainpa-admin-shadow-soft);
    color: inherit;
    display: block;
    min-height: 138px;
    padding: 20px;
    text-decoration: none;
    transition:
        border-color 150ms ease,
        box-shadow 150ms ease,
        transform 150ms ease;
}

.ainpa-tool-card:hover {
    border-color: #9dc4f2;
    box-shadow: var(--ainpa-admin-shadow);
    transform: translateY(-2px);
}

.ainpa-tool-card-title {
    color: #0b1728;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.35;
    margin: 0;
}

.ainpa-tool-card-description {
    color: var(--ainpa-admin-text-soft);
    font-size: 14px;
    line-height: 1.65;
    margin: 10px 0 0;
}

/* Admin menu builder */
.admin-menu-page {
    padding: 26px 0 42px;
}

.admin-menu-container {
    display: grid;
    gap: 22px;
}

.admin-menu-hero {
    align-items: flex-end;
    background:
        linear-gradient(135deg, #ffffff, #fff4ec 54%, #ffe4d8);
    border: 1px solid rgba(215, 25, 19, 0.16);
    border-radius: var(--ainpa-admin-radius);
    box-shadow: var(--ainpa-admin-shadow);
    color: var(--ainpa-admin-text);
    display: flex;
    gap: 24px;
    justify-content: space-between;
    padding: 26px;
}

.admin-menu-eyebrow {
    color: var(--ainpa-admin-primary-strong);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.08em;
    margin: 0 0 9px;
    text-transform: uppercase;
}

.admin-menu-title {
    font-size: 24px;
    font-weight: 850;
    line-height: 1.2;
    margin: 0;
}

.admin-menu-subtitle {
    color: #d7e7fb;
    font-size: 14px;
    line-height: 1.7;
    margin: 10px 0 0;
    max-width: 760px;
}

.admin-menu-hero-stats {
    display: flex;
    gap: 12px;
}

.admin-menu-stat {
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--ainpa-admin-radius-sm);
    min-width: 116px;
    padding: 12px 14px;
}

.admin-menu-stat strong,
.admin-menu-stat span {
    display: block;
}

.admin-menu-stat strong {
    font-size: 24px;
    line-height: 1;
}

.admin-menu-stat span {
    color: #c4d8ef;
    font-size: 12px;
    font-weight: 700;
    margin-top: 6px;
}

.admin-menu-tabs {
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius);
    box-shadow: var(--ainpa-admin-shadow-soft);
    display: inline-flex;
    gap: 6px;
    padding: 6px;
    width: fit-content;
}

.admin-menu-tab {
    border-radius: var(--ainpa-admin-radius-sm);
    color: var(--ainpa-admin-text-soft);
    font-size: 13px;
    font-weight: 850;
    min-height: 36px;
    padding: 9px 14px;
    text-decoration: none;
}

.admin-menu-tab:hover,
.admin-menu-tab.is-active {
    background: var(--ainpa-admin-primary-soft);
    color: var(--ainpa-admin-primary-strong);
}

.admin-menu-card {
    background: #ffffff;
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius);
    box-shadow: var(--ainpa-admin-shadow-soft);
    overflow: hidden;
}

.admin-menu-card-header {
    align-items: center;
    border-bottom: 1px solid var(--ainpa-admin-border);
    display: flex;
    gap: 16px;
    justify-content: space-between;
    padding: 20px 22px;
}

.admin-menu-card-title,
.admin-menu-source-title,
.admin-menu-panel-title,
.admin-menu-builder-title,
.admin-menu-builder-item-title {
    color: var(--ainpa-admin-text);
    font-weight: 850;
    margin: 0;
}

.admin-menu-card-title {
    font-size: 18px;
}

.admin-menu-card-subtitle,
.admin-menu-source-meta,
.admin-menu-panel-description,
.admin-menu-item-target,
.admin-menu-builder-item-meta,
.admin-menu-empty-small {
    color: var(--ainpa-admin-text-soft);
}

.admin-menu-card-subtitle {
    font-size: 13px;
    line-height: 1.55;
    margin: 5px 0 0;
}

.admin-menu-source-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 18px;
}

.admin-menu-source-card {
    background:
        linear-gradient(180deg, #ffffff, #f8fbff);
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius);
    box-shadow: 0 8px 18px rgba(8, 20, 38, 0.05);
    display: grid;
    gap: 14px;
    padding: 16px;
}

.admin-menu-source-card.is-active {
    border-color: #8ab8ef;
    box-shadow: 0 0 0 3px rgba(29, 111, 216, 0.10), var(--ainpa-admin-shadow-soft);
}

.admin-menu-source-link {
    color: inherit;
    text-decoration: none;
    transition:
        border-color 150ms ease,
        box-shadow 150ms ease,
        transform 150ms ease;
}

.admin-menu-source-link:hover {
    border-color: #8ab8ef;
    box-shadow: var(--ainpa-admin-shadow-soft);
    transform: translateY(-1px);
}

.admin-menu-source-main {
    align-items: flex-start;
    display: flex;
    gap: 12px;
    justify-content: space-between;
}

.admin-menu-source-title {
    font-size: 15px;
    line-height: 1.35;
}

.admin-menu-source-meta {
    font-size: 12px;
    line-height: 1.55;
    margin: 6px 0 0;
    overflow-wrap: anywhere;
}

.admin-menu-source-actions,
.admin-menu-actions,
.admin-menu-builder-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
}

.admin-menu-card-edit,
.admin-menu-panel {
    background: #f7fbff;
    border-top: 1px solid var(--ainpa-admin-border);
    padding: 20px 22px;
}

.admin-menu-form,
.admin-menu-form-stack {
    display: grid;
    gap: 18px;
}

.admin-menu-form-grid {
    display: grid;
    gap: 16px;
}

.admin-menu-form-grid-two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.admin-menu-form-grid-three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.admin-menu-form-grid-settings {
    align-items: end;
    grid-template-columns: minmax(96px, 0.45fr) minmax(120px, 0.55fr);
}

.admin-menu-description-field {
    grid-column: 1 / -1;
}

.admin-menu-form-grid-four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.admin-menu-form-grid-six {
    grid-template-columns: repeat(6, minmax(0, 1fr));
}

.admin-menu-form-grid-action {
    align-items: end;
    grid-template-columns: minmax(0, 1fr) auto;
}

.admin-menu-span-two {
    grid-column: span 2;
}

.admin-menu-check-field {
    justify-content: end;
}

.admin-menu-check-option {
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius-sm);
    color: var(--ainpa-admin-text);
    display: flex;
    font-size: 13px;
    font-weight: 800;
    gap: 9px;
    min-height: 42px;
    padding: 9px 12px;
}

.admin-menu-style-panel {
    background: #f1f7ff;
    border: 1px solid #c8dcf3;
    border-radius: var(--ainpa-admin-radius);
    display: grid;
    gap: 16px;
    padding: 16px;
}

.admin-menu-panel-heading {
    align-items: flex-start;
    display: flex;
    justify-content: space-between;
}

.admin-menu-panel-title {
    font-size: 14px;
}

.admin-menu-panel-description {
    font-size: 12px;
    line-height: 1.55;
    margin: 4px 0 0;
}

.admin-menu-color-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.admin-color-input {
    background: #ffffff;
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius-sm);
    height: 42px;
    padding: 4px;
    width: 100%;
}

.admin-menu-note {
    border-radius: var(--ainpa-admin-radius-sm);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.55;
    padding: 12px;
}

.admin-menu-note-warning {
    background: #fff7ed;
    border: 1px solid #fed7aa;
    color: #9a4f12;
}

.admin-menu-accordion {
    display: grid;
}

.admin-menu-accordion-item + .admin-menu-accordion-item {
    border-top: 1px solid var(--ainpa-admin-border);
}

.admin-menu-accordion-item.is-child {
    background: #fbfdff;
}

.admin-menu-accordion-button {
    align-items: center;
    background: transparent;
    border: 0;
    color: var(--ainpa-admin-text);
    cursor: pointer;
    display: grid;
    gap: 12px;
    grid-template-columns: 16px 34px minmax(0, 1fr) auto;
    padding: 16px 22px;
    text-align: left;
    width: 100%;
}

.admin-menu-accordion-button:hover {
    background: #f2f7fd;
}

.admin-menu-level {
    display: block;
    height: 1px;
}

.admin-menu-level-1 {
    border-left: 2px solid #9dc4f2;
    height: 38px;
    margin-left: 8px;
}

.admin-menu-level-2,
.admin-menu-level-3,
.admin-menu-level-4 {
    border-left: 2px solid #c2d7ee;
    height: 38px;
    margin-left: 8px;
}

.admin-menu-item-icon {
    align-items: center;
    background: #eaf3ff;
    border: 1px solid #c7ddf8;
    border-radius: var(--ainpa-admin-radius-sm);
    color: var(--ainpa-admin-primary-strong);
    display: inline-flex;
    font-size: 11px;
    font-weight: 900;
    height: 34px;
    justify-content: center;
    overflow: hidden;
    width: 34px;
}

.admin-menu-item-main {
    display: grid;
    gap: 4px;
    min-width: 0;
}

.admin-menu-item-title {
    color: var(--ainpa-admin-text);
    font-size: 14px;
    font-weight: 850;
    overflow-wrap: anywhere;
}

.admin-menu-item-target {
    font-family:
        ui-monospace,
        SFMono-Regular,
        Menlo,
        Consolas,
        "Liberation Mono",
        monospace;
    font-size: 12px;
    overflow-wrap: anywhere;
}

.admin-menu-item-meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
}

.admin-menu-badge,
.admin-menu-sort,
.admin-menu-toggle-text {
    border-radius: 999px;
    font-size: 11px;
    font-weight: 850;
    line-height: 1;
    padding: 6px 9px;
    white-space: nowrap;
}

.admin-menu-badge {
    background: #eef5ff;
    color: #285d99;
}

.admin-menu-sort {
    background: #f1f5f9;
    color: #53657d;
}

.admin-menu-toggle-text {
    background: var(--ainpa-admin-primary-strong);
    color: #ffffff;
}

.admin-menu-danger-form {
    border-top: 1px solid var(--ainpa-admin-border);
    display: flex;
    justify-content: flex-end;
    margin-top: 18px;
    padding-top: 16px;
}

.admin-menu-empty {
    color: var(--ainpa-admin-text-soft);
    font-size: 14px;
    padding: 24px;
}

.admin-menu-builder-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.admin-menu-builder-column {
    border-right: 1px solid var(--ainpa-admin-border);
    min-width: 0;
    padding: 20px;
}

.admin-menu-builder-column:last-child {
    border-right: 0;
}

.admin-menu-builder-title {
    color: var(--ainpa-admin-text-soft);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.admin-menu-builder-list {
    display: grid;
    gap: 12px;
    margin-top: 14px;
}

.admin-menu-builder-item {
    align-items: flex-start;
    border: 1px solid var(--ainpa-admin-border);
    border-radius: var(--ainpa-admin-radius-sm);
    display: flex;
    gap: 12px;
    justify-content: space-between;
    padding: 12px;
}

.admin-menu-builder-item-title {
    font-size: 13px;
    overflow-wrap: anywhere;
}

.admin-menu-builder-item-meta {
    font-size: 12px;
    margin-top: 4px;
}

.admin-menu-inline-link {
    color: var(--ainpa-admin-primary-strong);
    font-size: 13px;
    font-weight: 850;
    text-decoration: none;
}

.admin-menu-inline-link:hover {
    color: var(--ainpa-admin-primary);
    text-decoration: underline;
}

/* Modals, dropdowns, and overlays */
[role="dialog"],
.modal,
.dropdown,
.absolute.bg-white,
.fixed.bg-white {
    border-color: var(--ainpa-admin-border) !important;
    border-radius: var(--ainpa-admin-radius) !important;
    box-shadow: var(--ainpa-admin-shadow) !important;
}

/* Pagination */
nav[role="navigation"] a,
nav[role="navigation"] span {
    border-color: var(--ainpa-admin-border) !important;
}

nav[role="navigation"] span[aria-current="page"] span {
    background: var(--ainpa-admin-primary-soft) !important;
    color: var(--ainpa-admin-primary-strong) !important;
}

/* Floating assistant widgets stay above themed surfaces */
#ai-assistant-widget,
#pp-widget,
.ai-assistant-widget,
.ppw {
    z-index: 1200;
}

/* Mobile keeps the existing drawer behavior but improves color consistency. */
@media (max-width: 768px) {
    body .min-h-screen.bg-gray-100 {
        padding-left: 0 !important;
        padding-top: var(--ainpa-admin-topbar-height) !important;
    }

    .z4-admin-sidebar {
        display: none !important;
    }

    .z4-admin-home-link,
    .z4-admin-profile-link,
    .z4-admin-logout-form {
        display: none;
    }

    .z4-mobile-overlay {
        background: rgba(1, 8, 20, 0.56);
        bottom: 0;
        display: block;
        left: 0;
        position: fixed;
        right: 0;
        top: var(--ainpa-admin-topbar-height);
        z-index: 1040;
    }

    .z4-mobile-drawer {
        background: var(--ainpa-admin-sidebar-deep) !important;
        bottom: 0;
        color: #e5eef8 !important;
        display: block;
        left: 0;
        overflow-y: auto;
        position: fixed;
        top: var(--ainpa-admin-topbar-height);
        width: min(86vw, 320px);
        z-index: 1050;
    }

    .z4-mobile-drawer-header {
        align-items: center;
        border-bottom: 1px solid var(--ainpa-admin-sidebar-line);
        display: flex;
        justify-content: space-between;
        min-height: 52px;
        padding: 10px 12px;
    }

    .z4-mobile-logo {
        height: 32px;
        width: auto;
    }

    .z4-mobile-close-button {
        background: transparent;
        border: 0;
        color: #d9e9fb;
        cursor: pointer;
        font-size: 12px;
        font-weight: 800;
    }

    .z4-mobile-drawer-body {
        padding: 10px;
    }

    .z4-mobile-section {
        border-bottom: 1px solid rgba(148, 180, 220, 0.10);
        padding: 8px 0;
    }

    .z4-mobile-section-title {
        color: #8fa7c4;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 0.03em;
        padding: 4px 8px 8px;
        text-transform: uppercase;
    }

    .z4-mobile-link,
    .z4-mobile-sublink {
        border-radius: var(--ainpa-admin-radius-sm);
        color: #c7d8eb;
