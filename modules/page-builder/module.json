{
  "name": "Page Builder",
  "slug": "page-builder",
  "version": "2.1.0",
  "type": "feature",
  "core": true,
  "platform_version": ">=2.5.0 <3.0.0",
  "description": "Unified visual Page Builder for pages, headers, footers, bodies and reusable blocks, with Theme Builder selecting active frontend compositions by reference.",
  "author": "Art INPA",
  "provider": "Modules\\PageBuilder\\PageBuilderServiceProvider",
  "provider_file": "src/PageBuilderServiceProvider.php",
  "dependencies": [],
  "routes": {
    "admin": {
      "file": "routes/admin.php",
      "prefix": "",
      "name": "",
      "middleware": ["web", "auth", "staff"]
    },
    "web": {
      "file": "routes/web.php",
      "prefix": "",
      "name": "",
      "middleware": ["web"]
    }
  },
  "permissions": [
    {
      "name": "pages.manage",
      "description": "Manage Page Builder pages, templates and revisions."
    },
    {
      "name": "front-builder.manage",
      "description": "Legacy alias retained for existing role assignments."
    }
  ],
  "menus": [
    {
      "key": "page-builder.admin",
      "name": "Page Builder",
      "location": "admin",
      "items": [
        {
          "title": "Page Builder",
          "route": "admin.pages.index",
          "icon": "layout",
          "permission": "pages.manage",
          "order": 10
        }
      ]
    }
  ],
  "migrations": "database/migrations",
  "lifecycle": {
    "file": "src/PageBuilderLifecycle.php",
    "install": "Modules\\PageBuilder\\PageBuilderLifecycle@consolidate",
    "activate": "Modules\\PageBuilder\\PageBuilderLifecycle@consolidate",
    "reactivate": "Modules\\PageBuilder\\PageBuilderLifecycle@consolidate"
  },
  "uninstall": {
    "tables": [],
    "settings": [],
    "storage_paths": [],
    "records": [],
    "columns": [
      {
        "table": "platform_pages",
        "columns": ["parent_id", "category", "menu_label", "show_in_menu"]
      }
    ],
    "operation_target_prefixes": ["platform-page", "page-builder", "front-builder"]
  }
}
